  {
    "metadata": {"name": "platform-service", "namespace": "platform", "labels": {"app": "platform-service", "team": "platform"}, "annotations": {}},
    "spec": {
      "replicas": 2,
      "template": {
        "spec": {
          "containers": [
            {
              "name": "platform-service",
              "image": "registry.cn-hangzhou.aliyuncs.com/mekari/platform-service:v4.5.2",
              "ports": [{"containerPort": 8080}, {"containerPort": 9090}],
              "resources": {
                "requests": {"cpu": "500m", "memory": "1Gi"},
                "limits": {"cpu": "2000m", "memory": "4Gi"}
              },
              "readinessProbe": {"httpGet": {"path": "/health/ready", "port": 8080, "scheme": "HTTP"}},
              "livenessProbe": {"httpGet": {"path": "/health/live", "port": 8080, "scheme": "HTTP"}},
              "envFrom": [
                {"configMapRef": {"name": "platform-config"}},
