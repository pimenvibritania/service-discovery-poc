    "spec": {
      "replicas": 2,
      "template": {
        "spec": {
          "containers": [
            {
              "name": "billing-service",
              "image": "registry.cn-hangzhou.aliyuncs.com/mekari/billing-service:v3.0.1",
              "ports": [{"containerPort": 8080}],
              "resources": {
                "requests": {"cpu": "200m", "memory": "512Mi"},
                "limits": {"cpu": "800m", "memory": "2Gi"}
              },
              "readinessProbe": {"httpGet": {"path": "/health", "port": 8080, "scheme": "HTTP"}},
              "livenessProbe": {"httpGet": {"path": "/health", "port": 8080, "scheme": "HTTP"}},
              "envFrom": [
                {"configMapRef": {"name": "billing-config"}},
                {"secretRef": {"name": "billing-secrets"}}
              ],
              "env": []
            }
          ]
        }
      }
    }
  },
  {
    "metadata": {"name": "notification-service", "namespace": "notification", "labels": {"app": "notification-service", "team": "platform"}, "annotations": {}},
    "spec": {
      "replicas": 1,
      "template": {
        "spec": {
          "containers": [
            {
              "name": "notification-service",
              "image": "registry.cn-hangzhou.aliyuncs.com/mekari/notification-service:v1.2.0",
              "ports": [{"containerPort": 8080}],
              "resources": {
                "requests": {"cpu": "100m", "memory": "256Mi"},
                "limits": {"cpu": "500m", "memory": "512Mi"}
              },
              "readinessProbe": {"httpGet": {"path": "/ready", "port": 8080, "scheme": "HTTP"}},
              "livenessProbe": {"httpGet": {"path": "/live", "port": 8080, "scheme": "HTTP"}},
              "envFrom": [
                {"configMapRef": {"name": "notification-config"}},
                {"secretRef": {"name": "notification-secrets"}}
